{
    "name": "yolu/kirby-video-thumbnail",
    "description": "Kirby Panel plugin that auto-generates a thumbnail from a video frame on upload, with a scrubber to pick the exact frame.",
    "type": "kirby-plugin",
    "version": "2.0.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Jonathan Hess",
            "homepage": "https://yolu.ch"
        }
    ],
    "require": {
        "php": ">=8.3",
        "getkirby/cms": "^6.0",
        "getkirby/composer-installer": "^1.0"
    },
    "extra": {
        "kirby": {
            "compatible": "^6.0"
        }
    }
}
